# Minimum local configuration.
# Vite embeds VITE_* values in the browser bundle. Restrict the Google Maps
# key in Google Cloud by allowed HTTP referrers, Maps APIs, and quota.
VITE_GOOGLE_MAPS_API_KEY=

# Server-only OpenRouter configuration. Never prefix these values with VITE_.
LLM_API_KEY=
LLM_API_URL=https://openrouter.ai/api/v1
LLM_MODEL=minimax/minimax-m3:free
LLM_FALLBACK_MODEL=cohere/north-mini-code:free

# Optional operational overrides. The application uses these defaults when
# they are omitted. Set BUKI_ALLOWED_ORIGINS only in the relevant environment;
# for Vercel Production use https://buki-iota.vercel.app.
# BUKI_MODE=real
# BUKI_ALLOWED_ORIGINS=
# BUKI_RATE_LIMIT_MAX=12
# BUKI_RATE_LIMIT_WINDOW_MS=600000
